{
  "name": "attention-highlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "《注意力高亮》客户端（A 轨道）+ 并入的 B 轨道算法包",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:packages": "tsc -b packages/engine",
    "validate:levels": "node packages/schema/dist/cli.js validate apps/web/src/levels/levels.draft.json --mode draft",
    "typecheck": "tsc -b packages/engine && tsc -p apps/web/tsconfig.json",
    "test": "node --test \"apps/web/tests/**/*.test.ts\"",
    "verify": "pnpm build:packages && pnpm validate:levels && pnpm test",
    "dev": "pnpm build:packages && pnpm --filter @attention/web dev",
    "build": "pnpm build:packages && pnpm --filter @attention/web build",
    "preview": "pnpm --filter @attention/web preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
