{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attention-highlight.local/schema/daily-vote-v1.json",
  "title": "Daily Vote Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tokenIndices"],
  "properties": {
    "tokenIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
