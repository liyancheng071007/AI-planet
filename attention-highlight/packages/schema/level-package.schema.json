{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attention-highlight.local/schema/level-package-v1.json",
  "title": "Attention Highlight Level Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "status",
    "generatedAt",
    "modelLockHash",
    "levels"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "release"] },
    "generatedAt": { "type": "string", "minLength": 20 },
    "modelLockHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://attention-highlight.local/schema/level-v1.json"
      }
    }
  }
}
