{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attention-highlight.local/schema/level-v1.json",
  "title": "Attention Highlight Level v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "level",
    "template",
    "tokens",
    "focus",
    "punct",
    "coref",
    "causal",
    "attention",
    "scoring",
    "explain",
    "humanRationale",
    "provenance",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^(L[1-6]-[A-Za-z0-9-]+|GOLDEN-[A-Za-z0-9-]+)$"
    },
    "level": { "type": "integer", "minimum": 1, "maximum": 6 },
    "template": {
      "type": "string",
      "enum": [
        "coref",
        "coref-repeat",
        "causal",
        "contrast",
        "negation",
        "comparison",
        "emotion",
        "time",
        "condition",
        "purpose",
        "modifier",
        "parallel"
      ]
    },
    "tokens": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1 }
    },
    "focus": { "type": "integer", "minimum": 0 },
    "punct": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "coref": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "members", "refersFrom"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "refersFrom": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          }
        }
      }
    },
    "causal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "effect"],
        "properties": {
          "cause": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "effect": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "connective": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lenses",
        "lensConfigId",
        "modelVersion",
        "probeSetHash",
        "stability",
        "crossModelAgreement",
        "caseStrength"
      ],
      "properties": {
        "lenses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["panorama", "coref", "causal", "emotion", "position"],
          "properties": {
            "panorama": { "$ref": "#/$defs/weights" },
            "coref": { "$ref": "#/$defs/weights" },
            "causal": { "$ref": "#/$defs/weights" },
            "emotion": { "$ref": "#/$defs/weights" },
            "position": { "$ref": "#/$defs/weights" }
          }
        },
        "lensConfigId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "probeSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "crossModelAgreement": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "caseStrength": { "type": "number", "minimum": 0 }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap", "bCumulative", "maxTargets"],
      "properties": {
        "cap": { "type": "integer", "minimum": 1, "maximum": 16 },
        "bCumulative": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maxTargets": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copyId", "text"],
      "properties": {
        "copyId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
    },
    "humanRationale": { "type": "string", "minLength": 1 },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenIndices", "rationale"],
        "properties": {
          "tokenIndices": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pipelineVersion"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["ai-assisted", "human-authored"]
        },
        "pipelineVersion": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "rejected"]
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "required": ["reviewer", "reviewedAt"] }
        }
      ]
    }
  },
  "$defs": {
    "weights": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": { "type": "number", "minimum": 0 }
    }
  }
}
