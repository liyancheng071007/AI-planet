<view class="page">
  <view class="eyebrow">PLANET LAB / AI星球</view>
  <view wx:if="{{demo}}" class="notice">本机演示模式 · 未连接微信云端，进度仅保存在本设备。</view>
  <view class="hero"><view class="eyebrow">智能核心修复计划</view><view class="title">下一站，<br/>和 AI 一起探索未来。</view><view class="muted">收集8块芯片，学习数据、训练、推理与改进。</view><view class="planet">🪐</view></view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <button wx:if="{{!ready}}" bindtap="load" loading="{{loading}}" disabled="{{loading}}">{{loading?'读取存档中':'重试连接'}}</button>
  <block wx:if="{{ready}}">
    <view class="stats"><view class="stat"><view class="muted">核心芯片</view><view class="value">{{completed}} / 8</view></view><view class="stat"><view class="muted">算力币</view><view class="value">{{coins}}</view></view></view>
    <view class="heading">选择你的下一场冒险</view>
    <view class="grid"><view wx:for="{{items}}" wx:key="id" class="tile {{item.color}}" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="eyebrow">SECTOR {{item.number}}</text><text class="badge">{{item.done?'已修复':item.unlocked?'可挑战':'待解锁'}}</text></view><view class="icon">{{item.icon}}</view><view class="heading">{{item.short}}</view><view class="muted">{{item.desc}}</view></view></view>
  </block>
  <view class="notice">不输入姓名、人脸、电话或其他个人信息。AI会犯错，保持核实与思考。</view>
</view>
