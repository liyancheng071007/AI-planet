<view class="page"><view class="eyebrow">EXPLORER PASSPORT</view><view class="title">我的训练师护照</view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <button wx:if="{{!ready}}" bindtap="load" disabled="{{busy}}" loading="{{busy}}">重新读取</button>
  <block wx:if="{{ready}}">
    <view class="hero"><view class="title">{{award}}</view><view class="muted">已收集 {{state.completed.length}} / 8 块芯片</view><view class="planet">{{state.completed.length===8?'🏆':'🪐'}}</view></view>
    <view class="panel"><view class="label">小队代号（仅存本机，不填真实姓名）</view><input value="{{team}}" maxlength="24" bindinput="team" disabled="{{busy}}"/><view class="field"><view class="label">课堂节奏</view><picker range="{{modes}}" value="{{modeIndex}}" bindchange="mode" disabled="{{busy}}"><view class="picker">{{modes[modeIndex]}} ▾</view></picker></view>
      <view class="label">团队协作自评</view><checkbox-group bindchange="collaboration"><label wx:for="{{collaborationLabels}}" wx:key="*this" class="choice"><checkbox value="{{index}}" checked="{{state.collaborationItems[index]}}" disabled="{{busy}}" color="#8160bd"/>{{item}}</label></checkbox-group><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存护照</button>
    </view>
    <view class="notice">金牌条件：完成8关、平均分≥85、数据卡≥20、算力币≥5、协作自评≥2。文字作品仅在当前设备保留。</view>
    <view wx:for="{{records}}" wx:key="id" class="panel"><view class="row"><view class="heading">{{item.name}}</view><text class="badge">{{item.done?item.score+'分':'待探索'}}</text></view><view class="muted">{{item.badge}}</view><view wx:if="{{item.work}}" class="work">{{item.work}}</view></view>
    <button bindtap="export" disabled="{{busy}}">复制护照记录</button><button bindtap="reset" disabled="{{busy}}">重新开始</button><button class="danger" bindtap="remove" disabled="{{busy}}">删除云端存档与本机作品</button>
  </block>
</view>
